# Replace all placeholders. This file contains examples, never real credentials.
RADARR_URL=http://radarr.example.com:7878
RADARR_API_KEY=replace-with-your-radarr-api-key
SONARR_URL=http://sonarr.example.com:8989
SONARR_API_KEY=replace-with-your-sonarr-api-key
EMBY_URL=http://emby.example.com:8096
# Optional browser-facing Emby base URL, including a base path if applicable.
EMBY_PUBLIC_URL=https://emby.example.com
# Generate this locally; see README. Preserve it when restoring the database.
PORTAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
PORTAL_ORIGINS=https://requests.example.com
PORTAL_SECURE_COOKIE=true
# Use actual profile IDs from each application; these may differ.
RADARR_PROFILE_ID=1
SONARR_PROFILE_ID=1
# Paths as seen INSIDE Radarr/Sonarr, already registered as root folders.
MOVIE_ROOT=/media/movies
TV_ROOT=/media/tv
# Optional; blank values use TV_ROOT. Category still controls Sonarr series type.
ANIME_ROOT=/media/anime
CARTOONS_ROOT=/media/cartoons
# Optional Host headers for private endpoints behind hostname restrictions.
RADARR_HOST_HEADER=
SONARR_HOST_HEADER=
# Only trust CF-Connecting-IP from these immediate peer IPs; empty trusts none.
PORTAL_TRUSTED_PROXY_IPS=
# Compose-only settings. Loopback is appropriate for a proxy on the same host.
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_PORT=8000
